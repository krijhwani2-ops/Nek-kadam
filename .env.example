# ─── Central API (Express) ───
PORT=3001

# Backend selection for `npm start` / Electron (when DATABASE_URL is unset):
# - Auto: uses server.cjs (SQLite) if nekkadam.db exists in project root
# - Force: NEK_KADAM_BACKEND=sqlite | pg
# NEK_KADAM_BACKEND=sqlite

# ─── PostgreSQL (prefer one style) ───
# Single URL — used by `server_pg`, migrate scripts, Electron when configured with .env
DATABASE_URL=postgresql://nekkadam_app:YOUR_PASSWORD_HERE@192.168.1.50:5432/nekkadam

# Optional — superuser / maintenance (CREATE DATABASE); if unset and DATABASE_URL set,
# `setup_pg.cjs` rewrites path to `/postgres`.
# POSTGRES_SUPER_URL=postgresql://postgres:...@127.0.0.1:5432/postgres

# ─── Discrete vars (alternative to DATABASE_URL) ───
# PGUSER=postgres
# PGPASSWORD=
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=nekkadam

# ─── Pool tuning (mini PC / kiosk host) ───
# PGPOOL_MAX=24
# PG_IDLE_TIMEOUT_MS=30000
# PG_CONN_TIMEOUT_MS=10000
