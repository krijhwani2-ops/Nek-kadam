# ─── Render.com / Cloud Production Environment ───
# Copy this file to .env on the cloud server

# Render auto-sets PORT — do not hardcode
# PORT=3001

# PostgreSQL connection (Supabase / Neon / Render Postgres)
DATABASE_URL=postgresql://user:YOUR_PASSWORD_HERE@host:5432/nekkadam

# Node environment
NODE_ENV=production
